<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Champion Travel Co.</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
/* ── PRD 3.0 CSS VARIABLES ── */
:root {
  --primary: #5DADE2;
  --dark-blue: #0B3C5D;
  --white: #FFFFFF;
  --gold: #E6A341;
  --beige: #F5E6D3;
  --gold-dark: #C8892E;
  --primary-light: #AED6F1;
  --primary-pale: #EAF4FB;
  --text-dark: #0B3C5D;
  --text-muted: #5A7A9A;
  --border: #D6E8F5;
  --shadow: rgba(11,60,93,.12);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Montserrat', sans-serif; background: var(--white); color: var(--text-dark); overflow-x: hidden; }

/* ════ NAVBAR — Dark Blue ════ */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: var(--dark-blue); box-shadow: 0 2px 24px rgba(11,60,93,.35); }
.nav-inner { max-width: 1300px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 64px; }
.nav-logo { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; color: var(--white); cursor: pointer; user-select: none; white-space: nowrap; letter-spacing: .5px; }
.nav-logo span { color: var(--gold); }
.nav-links { display: flex; align-items: center; list-style: none; }
.nav-links li a { display: block; padding: 0 1rem; height: 64px; line-height: 64px; color: rgba(255,255,255,.85); text-decoration: none; font-weight: 600; font-size: .75rem; letter-spacing: 1.5px; text-transform: uppercase; transition: color .2s; position: relative; white-space: nowrap; }
.nav-links li a::after { content: ''; position: absolute; bottom: 0; left: 50%; right: 50%; height: 3px; background: var(--gold); transition: left .25s, right .25s; border-radius: 2px 2px 0 0; }
.nav-links li a:hover { color: var(--gold); }
.nav-links li a:hover::after { left: 1rem; right: 1rem; }
.nav-links li a.active { color: var(--gold); font-weight: 700; }
.nav-links li a.active::after { left: 1rem; right: 1rem; }

/* Hamburger */
.hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 6px; border: none; background: none; }
.hamburger span { display: block; width: 24px; height: 2px; background: var(--white); border-radius: 2px; transition: transform .3s, opacity .3s; }
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.mobile-menu { display: none; flex-direction: column; background: var(--dark-blue); border-top: 1px solid rgba(255,255,255,.1); }
.mobile-menu a { padding: .9rem 2rem; color: rgba(255,255,255,.85); text-decoration: none; font-weight: 600; font-size: .82rem; letter-spacing: 1.2px; text-transform: uppercase; border-bottom: 1px solid rgba(255,255,255,.06); transition: background .2s, color .2s; }
.mobile-menu a:hover, .mobile-menu a.active { background: rgba(93,173,226,.15); color: var(--gold); }
.mobile-menu.open { display: flex; }

/* ════ PAGES ════ */
.page { display: none; min-height: 100vh; padding-top: 64px; }
.page.active { display: block; animation: fadeIn .4s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

/* ════ HERO — Light Blue overlay ════ */
.hero { position: relative; min-height: 90vh; display: flex; align-items: center; overflow: hidden; background: var(--dark-blue); }
.hero-bg { position: absolute; inset: 0; background: linear-gradient(135deg, #0B3C5D 0%, #1A6FA3 55%, #5DADE2 100%); opacity: .96; }
.hero-pattern { position: absolute; inset: 0; background-image: radial-gradient(circle at 15% 85%, rgba(93,173,226,.35) 0%, transparent 45%), radial-gradient(circle at 85% 15%, rgba(230,163,65,.15) 0%, transparent 42%), url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23FFFFFF' fill-opacity='0.025'%3E%3Ccircle cx='40' cy='40' r='28'/%3E%3C/g%3E%3C/svg%3E"); }
.hero-wave { position: absolute; bottom: -2px; left: 0; right: 0; height: 80px; background: var(--white); clip-path: ellipse(55% 100% at 50% 100%); }
.hero-content { position: relative; z-index: 2; max-width: 1300px; margin: 0 auto; padding: 5rem 2rem 8rem; display: grid; grid-template-columns: 1.1fr .9fr; gap: 5rem; align-items: center; }
.hero-badge { display: inline-flex; align-items: center; gap: .5rem; background: rgba(230,163,65,.16); border: 1px solid rgba(230,163,65,.38); color: var(--gold); font-size: .7rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: .45rem 1rem; border-radius: 20px; margin-bottom: 1.5rem; }
.hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.8rem, 4.5vw, 4.8rem); font-weight: 900; color: var(--white); line-height: 1.1; margin-bottom: 1.5rem; }
.hero h1 em { color: var(--gold); font-style: italic; }
.hero-desc { color: rgba(255,255,255,.72); font-size: 1rem; line-height: 1.75; max-width: 500px; margin-bottom: 2.5rem; font-weight: 300; }
.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

/* Stats glass card */
.hero-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(255,255,255,.15); border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,.15); backdrop-filter: blur(8px); }
.stat-box { background: rgba(255,255,255,.07); padding: 1.8rem 1.2rem; text-align: center; }
.stat-num { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 900; color: var(--gold); }
.stat-label { font-size: .68rem; color: rgba(255,255,255,.5); text-transform: uppercase; letter-spacing: 1.2px; margin-top: .3rem; font-weight: 600; }

/* ════ BUTTONS ════ */
.btn-gold { padding: .9rem 2.2rem; background: var(--gold); color: var(--dark-blue); font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: .82rem; letter-spacing: 1px; text-transform: uppercase; border: none; border-radius: 5px; cursor: pointer; text-decoration: none; display: inline-block; transition: background .2s, transform .15s, box-shadow .2s; box-shadow: 0 4px 18px rgba(230,163,65,.3); }
.btn-gold:hover { background: var(--gold-dark); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(230,163,65,.42); }
.btn-outline-white { padding: .9rem 2.2rem; background: transparent; color: var(--white); font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: .82rem; letter-spacing: 1px; text-transform: uppercase; border: 2px solid rgba(255,255,255,.38); border-radius: 5px; cursor: pointer; text-decoration: none; display: inline-block; transition: border-color .2s, background .2s, transform .15s; }
.btn-outline-white:hover { border-color: var(--white); background: rgba(255,255,255,.1); transform: translateY(-2px); }

/* ════ SECTIONS ════ */
.section { max-width: 1300px; margin: 0 auto; padding: 5.5rem 2rem; }
.section-tag { display: inline-block; background: rgba(93,173,226,.1); color: var(--primary); border: 1px solid rgba(93,173,226,.28); font-size: .68rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: .35rem 1rem; border-radius: 20px; margin-bottom: 1rem; }
.section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 3vw, 2.9rem); font-weight: 900; color: var(--dark-blue); margin-bottom: 1rem; line-height: 1.15; }
.section-title em { color: var(--primary); font-style: italic; }
.section-sub { color: var(--text-muted); font-size: .95rem; line-height: 1.75; max-width: 560px; margin-bottom: 3rem; font-weight: 400; }

/* Service cards */
.services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
.service-card { background: var(--white); border-radius: 10px; padding: 2rem 1.8rem; border: 1.5px solid var(--border); cursor: pointer; transition: box-shadow .25s, transform .25s, border-color .25s; position: relative; overflow: hidden; }
.service-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, var(--primary), var(--gold)); transform: scaleX(0); transform-origin: left; transition: transform .3s; }
.service-card:hover { box-shadow: 0 14px 48px var(--shadow); transform: translateY(-5px); border-color: rgba(93,173,226,.4); }
.service-card:hover::before { transform: scaleX(1); }
.service-icon { font-size: 2rem; margin-bottom: 1.1rem; }
.service-card h3 { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--dark-blue); margin-bottom: .6rem; }
.service-card p { font-size: .84rem; color: var(--text-muted); line-height: 1.65; }
.service-arrow { display: inline-flex; align-items: center; gap: .4rem; color: var(--primary); font-weight: 700; font-size: .75rem; letter-spacing: .5px; margin-top: 1.1rem; cursor: pointer; transition: gap .2s, color .2s; text-decoration: none; text-transform: uppercase; }
.service-arrow:hover { gap: .8rem; color: var(--gold); }

/* Page banners */
.page-banner { background: var(--dark-blue); padding: 5rem 2rem 4rem; position: relative; overflow: hidden; }
.page-banner::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(93,173,226,.22) 0%, transparent 55%); }
.page-banner::after { content: ''; position: absolute; bottom: -2px; left: 0; right: 0; height: 60px; background: var(--white); clip-path: ellipse(55% 100% at 50% 100%); }
.page-banner-inner { max-width: 1300px; margin: 0 auto; position: relative; z-index: 1; }
.page-banner h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4vw, 3.5rem); font-weight: 900; color: var(--white); margin-bottom: .8rem; }
.page-banner h1 em { color: var(--gold); font-style: italic; }
.page-banner p { color: rgba(255,255,255,.62); font-size: .95rem; max-width: 560px; font-weight: 300; line-height: 1.7; }
.banner-badge { display: inline-flex; align-items: center; background: rgba(93,173,226,.2); border: 1px solid rgba(93,173,226,.35); color: var(--primary-light); font-size: .68rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: .4rem 1rem; border-radius: 20px; margin-bottom: 1.2rem; }

/* Country grid */
.country-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 1rem; margin-bottom: 3.5rem; }
.country-card { background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; padding: 1.4rem 1rem; text-align: center; cursor: pointer; transition: box-shadow .2s, transform .2s, border-color .25s; }
.country-card:hover { box-shadow: 0 8px 32px var(--shadow); transform: translateY(-4px); border-color: var(--gold); }
.country-card .flag { font-size: 2.2rem; margin-bottom: .6rem; }
.country-card h4 { font-family: 'Playfair Display', serif; font-size: .95rem; color: var(--dark-blue); margin-bottom: .2rem; }
.country-card span { font-size: .74rem; color: var(--text-muted); font-weight: 500; }

/* Roadmap */
.roadmap { display: flex; flex-direction: column; padding-left: 2.5rem; position: relative; margin-bottom: 3rem; }
.roadmap::before { content: ''; position: absolute; left: .85rem; top: 1.2rem; bottom: 1.2rem; width: 2px; background: linear-gradient(to bottom, var(--primary), var(--gold)); border-radius: 2px; }
.roadmap-step { position: relative; background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; padding: 1.3rem 1.5rem; margin-bottom: 1rem; transition: border-color .2s, box-shadow .2s; }
.roadmap-step:hover { border-color: rgba(93,173,226,.4); box-shadow: 0 4px 18px var(--shadow); }
.roadmap-step::before { content: attr(data-step); position: absolute; left: -2.5rem; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; background: var(--dark-blue); color: var(--gold); font-weight: 700; font-size: .76rem; border-radius: 50%; text-align: center; line-height: 28px; }
.roadmap-step h4 { font-weight: 700; color: var(--dark-blue); margin-bottom: .3rem; font-size: .92rem; }
.roadmap-step p { font-size: .82rem; color: var(--text-muted); line-height: 1.6; }

/* Getaway cards */
.getaway-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.8rem; }
.getaway-card { background: var(--white); border-radius: 14px; overflow: hidden; border: 1.5px solid var(--border); transition: box-shadow .25s, transform .25s; }
.getaway-card:hover { box-shadow: 0 18px 56px var(--shadow); transform: translateY(-6px); }
.getaway-thumb { height: 180px; display: flex; align-items: center; justify-content: center; font-size: 4rem; }
.getaway-body { padding: 1.6rem; }
.getaway-body h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--dark-blue); margin-bottom: .4rem; }
.getaway-body p { font-size: .845rem; color: var(--text-muted); line-height: 1.65; margin-bottom: 1rem; }
.getaway-meta { display: flex; gap: .7rem; flex-wrap: wrap; margin-bottom: 1rem; }
.meta-pill { background: var(--primary-pale); color: var(--dark-blue); padding: .28rem .85rem; border-radius: 20px; font-size: .72rem; font-weight: 700; letter-spacing: .5px; border: 1px solid rgba(93,173,226,.25); }
.price-tag { font-family: 'Playfair Display', serif; font-size: 1.7rem; color: var(--gold); font-weight: 700; }
.price-tag small { font-family: 'Montserrat', sans-serif; font-size: .74rem; color: var(--text-muted); font-weight: 400; }

/* Itinerary */
.itinerary-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
.day-card { background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 1rem; }
.day-header { background: var(--dark-blue); color: var(--white); padding: .85rem 1.3rem; font-weight: 700; font-size: .87rem; letter-spacing: .5px; }
.day-body { padding: 1.2rem; }
.day-activity { display: flex; gap: .8rem; align-items: flex-start; padding: .5rem 0; border-bottom: 1px dashed var(--border); font-size: .84rem; color: var(--text-dark); }
.day-activity:last-child { border-bottom: none; }
.day-activity .time { color: var(--primary); font-weight: 700; white-space: nowrap; min-width: 52px; font-size: .78rem; }
.journey-cta { background: linear-gradient(135deg, var(--dark-blue) 0%, #1a6fa3 100%); border-radius: 14px; padding: 2.5rem; color: var(--white); text-align: center; margin-bottom: 1.5rem; }
.journey-cta h3 { font-family: 'Playfair Display', serif; font-size: 1.75rem; margin-bottom: .8rem; }
.journey-cta h3 em { color: var(--gold); font-style: italic; }
.journey-cta p { color: rgba(255,255,255,.62); margin-bottom: 1.6rem; font-size: .9rem; line-height: 1.65; }

/* Corporate */
.corp-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; margin-bottom: 3rem; }
.corp-tile { background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; padding: 1.8rem 1.5rem; transition: box-shadow .2s, transform .2s, border-color .2s; }
.corp-tile:hover { box-shadow: 0 8px 32px var(--shadow); transform: translateY(-4px); border-color: rgba(93,173,226,.4); }
.corp-tile .icon { font-size: 2.1rem; margin-bottom: .8rem; }
.corp-tile h4 { font-weight: 700; color: var(--dark-blue); margin-bottom: .4rem; font-size: .95rem; }
.corp-tile p { font-size: .81rem; color: var(--text-muted); line-height: 1.6; }
.corp-cta { background: linear-gradient(135deg, var(--dark-blue), #1a6fa3); border-radius: 14px; padding: 3rem; display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; }
.corp-cta h3 { font-family: 'Playfair Display', serif; font-size: 1.75rem; color: var(--white); }
.corp-cta p { color: rgba(255,255,255,.62); margin-top: .5rem; font-size: .9rem; line-height: 1.6; }

/* Contact */
.contact-wrap { background: var(--beige); }
.contact-layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: 3rem; align-items: start; }
.contact-info h3 { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--dark-blue); margin-bottom: 1.6rem; }
.contact-item { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.6rem; }
.ci-icon { width: 46px; height: 46px; background: var(--white); border: 1.5px solid var(--border); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 2px 10px var(--shadow); }
.contact-item h4 { font-weight: 700; font-size: .88rem; color: var(--dark-blue); margin-bottom: .2rem; }
.contact-item p { font-size: .84rem; color: var(--text-muted); line-height: 1.55; }
.contact-form { background: var(--white); border: 1.5px solid var(--border); border-radius: 14px; padding: 2.5rem; box-shadow: 0 8px 40px var(--shadow); }
.contact-form h3 { font-family: 'Playfair Display', serif; font-size: 1.45rem; color: var(--dark-blue); margin-bottom: 1.8rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-group { margin-bottom: 1.2rem; }
.form-group label { display: block; font-size: .72rem; font-weight: 700; color: var(--dark-blue); margin-bottom: .45rem; letter-spacing: .8px; text-transform: uppercase; }
.form-group input, .form-group select, .form-group textarea { width: 100%; padding: .78rem 1rem; border: 1.5px solid var(--border); border-radius: 7px; font-family: 'Montserrat', sans-serif; font-size: .88rem; color: var(--dark-blue); background: var(--primary-pale); transition: border-color .2s, box-shadow .2s; outline: none; }
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(93,173,226,.15); background: var(--white); }
.form-group textarea { resize: vertical; min-height: 110px; }
.form-success { display: none; background: #e8f5f0; border: 1px solid #a3d9b5; border-radius: 8px; padding: 1.2rem; text-align: center; color: #1e6e45; font-weight: 600; font-size: .9rem; margin-top: 1rem; }
.form-success.show { display: block; }

/* Chatbot FAB */
.chatbot-fab { position: fixed; bottom: 2rem; right: 2rem; z-index: 900; width: 56px; height: 56px; background: var(--gold); color: var(--dark-blue); border-radius: 50%; border: none; cursor: pointer; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 24px rgba(230,163,65,.45); transition: transform .2s, box-shadow .2s; }
.chatbot-fab:hover { transform: scale(1.1); box-shadow: 0 10px 36px rgba(230,163,65,.55); }

/* Divider */
.divider { border: none; height: 1px; background: linear-gradient(to right, transparent, var(--border) 20%, var(--border) 80%, transparent); }

/* Footer */
footer { background: var(--dark-blue); color: rgba(255,255,255,.42); text-align: center; padding: 2rem; font-size: .8rem; letter-spacing: .5px; margin-top: 0; }
footer strong { color: var(--gold); }

/* CTA strip */
.cta-strip { background: var(--beige); padding: 3.5rem 0; }
.cta-strip-inner { max-width: 1300px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }

/* Responsive */
@media (max-width: 960px) {
  .hero-content { grid-template-columns: 1fr; gap: 3rem; }
  .itinerary-layout { grid-template-columns: 1fr; }
  .contact-layout { grid-template-columns: 1fr; }
  .corp-cta { grid-template-columns: 1fr; text-align: center; }
}
@media (max-width: 768px) {
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .form-row { grid-template-columns: 1fr; }
  .section { padding: 4rem 1.5rem; }
  .contact-form { padding: 1.8rem; }
  .hero-content { padding: 3.5rem 1.5rem 7rem; }
}
@media (max-width: 500px) {
  .hero-stats { grid-template-columns: 1fr 1fr; }
  .hero-btns { flex-direction: column; }
  .btn-gold, .btn-outline-white { text-align: center; }
  .country-grid { grid-template-columns: repeat(2,1fr); }
}
</style>
</head>
<body>

<!-- ══ NAVBAR ══ -->
<nav>
  <div class="nav-inner">
    <div class="nav-logo" onclick="navigate('home')">✈ Champion<span>Travel</span></div>
    <ul class="nav-links" id="navLinks">
      <li><a href="#" class="active" data-page="home"      onclick="navigate('home');return false;">Home</a></li>
      <li><a href="#" data-page="visa"      onclick="navigate('visa');return false;">Visa &amp; Passport</a></li>
      <li><a href="#" data-page="getaways"  onclick="navigate('getaways');return false;">Getaways</a></li>
      <li><a href="#" data-page="itinerary" onclick="navigate('itinerary');return false;">Itinerary</a></li>
      <li><a href="#" data-page="corporate" onclick="navigate('corporate');return false;">Corporate Travel</a></li>
      <li><a href="#" data-page="contact"   onclick="navigate('contact');return false;">Contact</a></li>
    </ul>
    <button class="hamburger" id="hamburger" onclick="toggleMenu()" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#" data-page="home"      onclick="navigate('home');closeMobile();return false;">🏠 Home</a>
    <a href="#" data-page="visa"      onclick="navigate('visa');closeMobile();return false;">🛂 Visa &amp; Passport</a>
    <a href="#" data-page="getaways"  onclick="navigate('getaways');closeMobile();return false;">🌍 Getaways</a>
    <a href="#" data-page="itinerary" onclick="navigate('itinerary');closeMobile();return false;">🧳 Itinerary</a>
    <a href="#" data-page="corporate" onclick="navigate('corporate');closeMobile();return false;">🏢 Corporate Travel</a>
    <a href="#" data-page="contact"   onclick="navigate('contact');closeMobile();return false;">📞 Contact</a>
  </div>
</nav>

<!-- Chatbot FAB (Dark Blue icon / Gold background) -->
<button class="chatbot-fab" title="Chat with us">💬</button>

<!-- ══════════════ HOME PAGE ══════════════ -->
<div id="page-home" class="page active">
