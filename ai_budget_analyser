<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Budgify — AI Expense Analyzer</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --pri: #4DA8DA; --dark: #1E3A5F; --gold: #D4AF37; --bg: #F5F5DC;
      --white: #fff; --text: #1A1A1A; --muted: #6b7a8d; --border: rgba(30,58,95,0.12);
      --pri-light: #e8f5fc; --danger: #e04040; --success: #2a9d6f;
      --radius: 14px; --radius-sm: 8px;
    }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .app { display: flex; min-height: 100vh; }

    /* SIDEBAR */
    .sidebar { width: 225px; min-height: 100vh; background: var(--dark); display: flex; flex-direction: column; padding: 28px 0; flex-shrink: 0; position: sticky; top: 0; height: 100vh; }
    .sidebar-logo { padding: 0 22px 28px; font-family: 'DM Serif Display', serif; font-size: 22px; color: var(--gold); border-bottom: 1px solid rgba(255,255,255,0.08); line-height: 1.2; }
    .sidebar-logo span { display: block; font-size: 11px; color: rgba(255,255,255,0.35); font-family: 'DM Sans', sans-serif; font-weight: 400; letter-spacing: 0.5px; margin-top: 4px; }
    .nav { margin-top: 20px; flex: 1; }
    .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 22px; cursor: pointer; color: rgba(255,255,255,0.5); font-size: 14px; border-left: 3px solid transparent; transition: all 0.2s; }
    .nav-item:hover { color: var(--white); background: rgba(255,255,255,0.05); }
    .nav-item.active { color: var(--gold); border-left-color: var(--gold); background: rgba(212,175,55,0.08); }
    .nav-icon { font-size: 15px; width: 20px; text-align: center; }
    .api-section { padding: 16px 22px; border-top: 1px solid rgba(255,255,255,0.08); }
    .api-label { font-size: 10px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    .api-input { width: 100%; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 7px 10px; font-size: 11px; color: rgba(255,255,255,0.6); font-family: monospace; outline: none; }
    .api-input:focus { border-color: rgba(212,175,55,0.5); color: rgba(255,255,255,0.9); }
    .api-hint { font-size: 10px; color: rgba(255,255,255,0.2); margin-top: 5px; line-height: 1.5; }
    .api-hint a { color: rgba(77,168,218,0.7); text-decoration: none; }
    .sidebar-footer { padding: 10px 22px; font-size: 10px; color: rgba(255,255,255,0.2); }

    /* MAIN */
    .main { flex: 1; overflow-y: auto; min-width: 0; }
    .topbar { background: var(--white); border-bottom: 1px solid var(--border); padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 10; }
    .topbar-title { font-size: 18px; font-weight: 500; color: var(--dark); }
    .topbar-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .topbar-actions { display: flex; gap: 10px; }
    .btn-primary { background: var(--pri); color: var(--white); border: none; padding: 9px 18px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: background 0.2s; font-family: 'DM Sans', sans-serif; }
    .btn-primary:hover { background: #3a94c5; }
    .btn-outline { background: transparent; color: var(--dark); border: 1px solid var(--border); padding: 9px 16px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; font-family: 'DM Sans', sans-serif; }
    .btn-outline:hover { border-color: var(--pri); color: var(--pri); }
    .content { padding: 28px 32px; }
    .page { display: none; }
    .page.active { display: block; }

    /* STATS */
    .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: var(--white); border-radius: var(--radius); border: 1px solid var(--border); padding: 20px; position: relative; overflow: hidden; }
    .stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--pri); }
    .stat-card.gold::before { background:var(--gold); }
    .stat-card.green::before { background:var(--success); }
    .stat-card.red::before { background:var(--danger); }
    .stat-label { font-size:11px; text-transform:uppercase; letter-spacing:0.7px; color:var(--muted); font-weight:500; }
    .stat-value { font-size:26px; font-weight:600; color:var(--dark); margin:8px 0 4px; font-family:'DM Serif Display',serif; }
    .stat-sub { font-size:12px; color:var(--muted); }
    .stat-icon { position:absolute; right:16px; top:16px; font-size:22px; opacity:0.1; }

    /* CHARTS */
    .charts-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px; }
    .chart-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:20px; }
    .card-title { font-size:14px; font-weight:500; color:var(--dark); margin-bottom:4px; }
    .card-sub { font-size:12px; color:var(--muted); margin-bottom:16px; }

    /* AI PANEL */
    .ai-card { background:linear-gradient(135deg,var(--dark) 0%,#2a4f7a 100%); border-radius:var(--radius); padding:24px; margin-bottom:24px; color:var(--white); position:relative; overflow:hidden; }
    .ai-card::after { content:'✦'; position:absolute; right:24px; top:18px; font-size:56px; color:rgba(212,175,55,0.1); }
    .ai-badge { display:inline-flex; align-items:center; gap:6px; background:rgba(212,175,55,0.2); color:var(--gold); padding:4px 12px; border-radius:20px; font-size:11px; font-weight:500; border:1px solid rgba(212,175,55,0.3); margin-bottom:14px; }
    .gemini-pill { background:rgba(66,133,244,0.2); color:#8ab4f8; padding:2px 8px; border-radius:10px; font-size:10px; margin-left:4px; }
    .ai-card h3 { font-family:'DM Serif Display',serif; font-size:20px; margin-bottom:16px; }
    .insights-list { display:flex; flex-direction:column; gap:10px; }
    .insight-item { background:rgba(255,255,255,0.08); border-radius:var(--radius-sm); padding:12px 16px; border-left:3px solid var(--gold); font-size:13px; line-height:1.5; }
    .insight-item.warning { border-left-color:#ff8c42; }
    .insight-item.good { border-left-color:#4cdc94; }
    .ai-loading { display:flex; align-items:center; gap:10px; padding:12px 0; font-size:13px; opacity:0.7; }
    .dot-pulse { display:flex; gap:4px; }
    .dot-pulse span { width:6px; height:6px; border-radius:50%; background:var(--gold); animation:pulse 1.2s ease-in-out infinite; }
    .dot-pulse span:nth-child(2){animation-delay:0.2s;} .dot-pulse span:nth-child(3){animation-delay:0.4s;}
    @keyframes pulse{0%,80%,100%{opacity:0.2;transform:scale(0.8)}40%{opacity:1;transform:scale(1)}}

    /* TABLE */
    .table-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); overflow:hidden; margin-bottom:24px; }
    .table-header { padding:16px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
    table { width:100%; border-collapse:collapse; }
    th { text-align:left; padding:12px 20px; font-size:11px; text-transform:uppercase; letter-spacing:0.6px; color:var(--muted); font-weight:500; background:#fafaf7; border-bottom:1px solid var(--border); }
    td { padding:12px 20px; font-size:13px; border-bottom:1px solid var(--border); vertical-align:middle; }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:#fafaf7; }
    .cat-badge { display:inline-flex; align-items:center; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:500; }
    .delete-btn { background:none; border:none; color:#ccc; cursor:pointer; font-size:14px; padding:4px 8px; border-radius:4px; transition:all 0.2s; }
    .delete-btn:hover { color:var(--danger); background:#fff0f0; }
    .cat-food{background:#fff3e0;color:#e65100;} .cat-travel{background:#e3f2fd;color:#0277bd;} .cat-shopping{background:#fce4ec;color:#c2185b;} .cat-entertainment{background:#f3e5f5;color:#7b1fa2;} .cat-health{background:#e8f5e9;color:#2e7d32;} .cat-education{background:#e0f7fa;color:#00695c;} .cat-utilities{background:#fff8e1;color:#f57f17;} .cat-other{background:#eceff1;color:#546e7a;}

    /* FORM */
    .form-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:32px; max-width:580px; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .form-group { margin-bottom:20px; }
    .form-label { font-size:12px; font-weight:500; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px; display:block; }
    .form-input,.form-select { width:100%; padding:11px 14px; border:1.5px solid var(--border); border-radius:var(--radius-sm); font-size:14px; font-family:'DM Sans',sans-serif; color:var(--text); background:var(--white); outline:none; transition:border-color 0.2s; }
    .form-input:focus,.form-select:focus { border-color:var(--pri); }
    .amount-wrap { position:relative; }
    .amount-prefix { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:15px; font-weight:500; }
    .amount-wrap .form-input { padding-left:26px; }
    .submit-btn { background:var(--dark); color:var(--white); border:none; padding:13px 28px; border-radius:var(--radius-sm); font-size:14px; font-weight:500; cursor:pointer; width:100%; transition:background 0.2s; font-family:'DM Sans',sans-serif; }
    .submit-btn:hover { background:var(--pri); }

    /* TOAST */
    .success-toast { position:fixed; bottom:24px; right:24px; background:var(--dark); color:var(--white); padding:14px 20px; border-radius:var(--radius-sm); font-size:13px; border-left:4px solid var(--success); display:none; z-index:9999; box-shadow:0 8px 32px rgba(0,0,0,0.25); animation:slideIn 0.3s ease; }
    @keyframes slideIn{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

    /* GOAL */
    .goal-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:24px; margin-bottom:20px; }
    .goal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
    .goal-title-el { font-family:'DM Serif Display',serif; font-size:20px; color:var(--dark); }
    .progress-bar-bg { background:#eef2f5; border-radius:20px; height:14px; overflow:hidden; margin-bottom:8px; }
    .progress-bar-fill { height:100%; border-radius:20px; background:linear-gradient(90deg,var(--pri),var(--gold)); transition:width 0.8s ease; }
    .progress-labels { display:flex; justify-content:space-between; font-size:12px; color:var(--muted); }
    .milestone-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:20px; }
    .milestone { text-align:center; padding:16px; border-radius:var(--radius-sm); background:var(--pri-light); border:1px solid rgba(77,168,218,0.2); }
    .milestone.done { background:#e8faf3; border-color:rgba(42,157,111,0.3); }
    .milestone-icon { font-size:20px; margin-bottom:6px; }
    .milestone-label { font-size:11px; color:var(--muted); font-weight:500; }
    .milestone-val { font-size:14px; font-weight:600; color:var(--dark); margin-bottom:4px; }

    /* REPORTS */
    .report-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px; }
    .report-card { background:var(--white); border-radius:var(--radius); border:1px solid var(--border); padding:20px; }
    .cat-breakdown { display:flex; flex-direction:column; gap:12px; }
    .cat-row { display:flex; align-items:center; gap:10px; }
    .cat-bar-bg { flex:1; background:#eef2f5; border-radius:4px; height:8px; overflow:hidden; }
    .cat-bar-fill { height:100%; border-radius:4px; }
    .cat-row-label { font-size:12px; color:var(--text); width:95px; flex-shrink:0; }
    .cat-row-val { font-size:12px; color:var(--muted); width:70px; text-align:right; flex-shrink:0; }

    /* PERIOD TABS */
    .period-tabs { display:flex; background:#eef2f5; border-radius:8px; padding:3px; width:fit-content; margin-bottom:20px; }
    .period-tab { padding:7px 18px; border-radius:6px; font-size:13px; cursor:pointer; color:var(--muted); transition:all 0.2s; }
    .period-tab.active { background:var(--white); color:var(--dark); font-weight:500; box-shadow:0 1px 4px rgba(0,0,0,0.08); }

    /* EMPTY */
    .empty-state { text-align:center; padding:48px 24px; color:var(--muted); }
    .empty-state-icon { font-size:36px; margin-bottom:12px; opacity:0.4; }
    .empty-state p { font-size:14px; }

    /* MODAL */
    .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.45); display:none; align-items:center; justify-content:center; z-index:100; }
    .modal-overlay.open { display:flex; }
    .modal { background:var(--white); border-radius:var(--radius); padding:32px; width:480px; max-width:95vw; position:relative; box-shadow:0 24px 64px rgba(0,0,0,0.2); }
    .modal-title { font-family:'DM Serif Display',serif; font-size:22px; color:var(--dark); margin-bottom:6px; }
    .modal-sub { font-size:13px; color:var(--muted); margin-bottom:24px; }
    .modal-close { position:absolute; right:20px; top:20px; background:none; border:none; font-size:20px; cursor:pointer; color:var(--muted); }
    .modal-close:hover { color:var(--danger); }

    @media(max-width:900px){.stats-grid{grid-template-columns:repeat(2,1fr);}.charts-row,.report-grid{grid-template-columns:1fr;}}
    @media(max-width:640px){.sidebar{width:180px;}.content{padding:20px 16px;}.topbar{padding:14px 16px;}}
  </style>
</head>
<body>
<div class="app">

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="sidebar-logo">₿udgify<span>AI Expense Analyzer</span></div>
    <div class="nav">
      <div class="nav-item active" onclick="showPage('dashboard',this)"><span class="nav-icon">◈</span> Dashboard</div>
      <div class="nav-item" onclick="showPage('add',this)"><span class="nav-icon">＋</span> Add Expense</div>
      <div class="nav-item" onclick="showPage('reports',this)"><span class="nav-icon">◉</span> Reports</div>
      <div class="nav-item" onclick="showPage('goals',this)"><span class="nav-icon">◎</span> Goal Tracker</div>
    </div>
    <div class="api-section">
      <div class="api-label">🔷 Gemini API Key (Free)</div>
      <input type="password" class="api-input" id="api-key-input" placeholder="AIzaSy..." oninput="saveApiKey(this.value)">
      <div class="api-hint">Get free key at <a href="https://aistudio.google.com/app/apikey" target="_blank">aistudio.google.com</a> → Get API Key. No credit card needed.</div>
    </div>
    <div class="sidebar-footer">Budgify v1.0 · Powered by Gemini 1.5 Flash</div>
  </nav>

  <!-- MAIN -->
  <div class="main">
    <div class="topbar">
      <div>
        <div class="topbar-title" id="page-title">Dashboard</div>
        <div class="topbar-sub" id="page-sub">Your financial overview at a glance</div>
      </div>
      <div class="topbar-actions">
        <button class="btn-outline" onclick="showPage('add',document.querySelectorAll('.nav-item')[1])">+ Add Expense</button>
        <button class="btn-primary" onclick="runAI()">✦ AI Analyze</button>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div class="page active content" id="page-dashboard">
      <div class="period-tabs">
        <div class="period-tab active" onclick="switchPeriod('month',this)">This Month</div>
        <div class="period-tab" onclick="switchPeriod('week',this)">This Week</div>
        <div class="period-tab" onclick="switchPeriod('all',this)">All Time</div>
      </div>
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon">₹</div><div class="stat-label">Total Spent</div><div class="stat-value" id="stat-total">₹0</div><div class="stat-sub" id="stat-total-sub">No expenses yet</div></div>
        <div class="stat-card gold"><div class="stat-icon">↑</div><div class="stat-label">Top Category</div><div class="stat-value" id="stat-top-cat" style="font-size:18px;padding-top:4px;">–</div><div class="stat-sub" id="stat-top-val">Add expenses to see</div></div>
        <div class="stat-card green"><div class="stat-icon">✦</div><div class="stat-label">Transactions</div><div class="stat-value" id="stat-count">0</div><div class="stat-sub">Total entries</div></div>
        <div class="stat-card red"><div class="stat-icon">◎</div><div class="stat-label">Avg per Day</div><div class="stat-value" id="stat-avg">₹0</div><div class="stat-sub">Daily spending</div></div>
      </div>
      <div class="charts-row">
        <div class="chart-card"><div class="card-title">Spending by Category</div><div class="card-sub">Category-wise breakdown</div><div style="position:relative;height:230px;"><canvas id="pieChart"></canvas></div></div>
        <div class="chart-card"><div class="card-title">Spending Trend</div><div class="card-sub">Daily expenses over time</div><div style="position:relative;height:230px;"><canvas id="barChart"></canvas></div></div>
      </div>
      <div class="ai-card">
        <div class="ai-badge">✦ AI Insights <span class="gemini-pill">Gemini</span></div>
        <h3>Smart Financial Analysis</h3>
        <div id="ai-insights-area">
          <div class="insights-list"><div class="insight-item">Enter your <strong>free Gemini API key</strong> in the sidebar, add your expenses, then click <strong>AI Analyze</strong> to get personalized insights powered by Google Gemini.</div></div>
        </div>
        <div style="margin-top:16px;"><button class="btn-primary" onclick="runAI()" style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);">✦ Generate Insights</button></div>
      </div>
      <div class="table-card">
        <div class="table-header"><div class="card-title">Recent Transactions</div><button class="btn-outline" onclick="showPage('reports',document.querySelectorAll('.nav-item')[2])" style="font-size:12px;padding:6px 12px;">View All</button></div>
        <div id="recent-table-body"><div class="empty-state"><div class="empty-state-icon">◈</div><p>No expenses yet. Add your first expense!</p></div></div>
      </div>
    </div>

    <!-- ADD EXPENSE -->
    <div class="page content" id="page-add">
      <div class="form-card">
        <div style="margin-bottom:28px;"><div style="font-family:'DM Serif Display',serif;font-size:20px;color:var(--dark);margin-bottom:6px;">Record New Expense</div><div style="font-size:13px;color:var(--muted);">Track your spending to get AI-powered insights</div></div>
        <div class="form-row">
          <div class="form-group"><label class="form-label">Amount (₹)</label><div class="amount-wrap"><span class="amount-prefix">₹</span><input type="number" class="form-input" id="inp-amount" placeholder="0" min="0" step="1"></div></div>
          <div class="form-group"><label class="form-label">Category</label><select class="form-select" id="inp-category"><option value="Food">🍕 Food</option><option value="Travel">✈ Travel</option><option value="Shopping">🛍 Shopping</option><option value="Entertainment">🎬 Entertainment</option><option value="Health">🏥 Health</option><option value="Education">📚 Education</option><option value="Utilities">💡 Utilities</option><option value="Other">📦 Other</option></select></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label class="form-label">Date</label><input type="date" class="form-input" id="inp-date"></div>
          <div class="form-group"><label class="form-label">Notes (optional)</label><input type="text" class="form-input" id="inp-notes" placeholder="e.g. Lunch at cafe"></div>
        </div>
        <button class="submit-btn" onclick="addExpense()">Add Expense →</button>
      </div>
    </div>

    <!-- REPORTS -->
    <div class="page content" id="page-reports">
      <div class="report-grid">
        <div class="report-card"><div class="card-title">Category Breakdown</div><div class="card-sub" style="margin-bottom:20px;">All-time spending by category</div><div id="cat-breakdown" class="cat-breakdown"><div class="empty-state" style="padding:20px 0;"><p>No data yet</p></div></div></div>
        <div class="report-card"><div class="card-title">Savings Potential</div><div class="card-sub" style="margin-bottom:20px;">AI-identified areas to cut back</div><div id="savings-area"><div class="empty-state" style="padding:20px 0;"><p>Run AI Analyze to see insights</p></div></div></div>
      </div>
      <div class="table-card">
        <div class="table-header"><div class="card-title">All Expenses</div><div style="display:flex;align-items:center;gap:12px;"><span id="total-count-label" style="font-size:12px;color:var(--muted);">0 transactions</span><button class="btn-outline" onclick="clearAll()" style="font-size:11px;padding:5px 10px;color:var(--danger);border-color:rgba(224,64,64,0.3);">Clear All</button></div></div>
        <div id="full-table-body"><div class="empty-state"><div class="empty-state-icon">◈</div><p>No expenses recorded yet</p></div></div>
      </div>
    </div>

    <!-- GOALS -->
    <div class="page content" id="page-goals">
      <div class="goal-card">
        <div class="goal-header"><div><div class="goal-title-el" id="goal-title-display">Set Your Savings Goal</div><div style="font-size:13px;color:var(--muted);margin-top:4px;" id="goal-sub">Define a target to work towards</div></div><button class="btn-outline" onclick="openGoalModal()">Edit Goal</button></div>
        <div class="progress-bar-bg"><div class="progress-bar-fill" id="progress-fill" style="width:0%"></div></div>
        <div class="progress-labels"><span id="progress-saved">₹0 saved</span><span id="progress-pct">0%</span><span id="progress-target">Goal: ₹0</span></div>
        <div class="milestone-grid">
          <div class="milestone" id="m1"><div class="milestone-icon">◎</div><div class="milestone-val" id="m1-val">₹0</div><div class="milestone-label">First Quarter (25%)</div></div>
          <div class="milestone" id="m2"><div class="milestone-icon">◉</div><div class="milestone-val" id="m2-val">₹0</div><div class="milestone-label">Halfway (50%)</div></div>
          <div class="milestone" id="m3"><div class="milestone-icon">✦</div><div class="milestone-val" id="m3-val">₹0</div><div class="milestone-label">Goal Reached!</div></div>
        </div>
      </div>
      <div class="ai-card">
        <div class="ai-badge">✦ Goal AI <span class="gemini-pill">Gemini</span></div>
        <h3>How to Reach Your Goal Faster</h3>
        <div id="goal-ai-area"><div class="insights-list"><div class="insight-item">Set a savings goal and run AI Analyze to get a personalized roadmap to reach it faster.</div></div></div>
        <div style="margin-top:16px;"><button class="btn-primary" onclick="runAI()" style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);">✦ Get Goal Strategy</button></div>
      </div>
    </div>
  </div>
</div>

<!-- GOAL MODAL -->
<div class="modal-overlay" id="goal-modal">
  <div class="modal">
    <button class="modal-close" onclick="closeGoalModal()">✕</button>
    <div class="modal-title">Set Savings Goal</div>
    <div class="modal-sub">Define your target and track progress toward it</div>
    <div class="form-group"><label class="form-label">Goal Name</label><input type="text" class="form-input" id="goal-name" placeholder="e.g. New Phone, Trip to Goa, Emergency Fund"></div>
    <div class="form-group"><label class="form-label">Target Amount (₹)</label><div class="amount-wrap"><span class="amount-prefix">₹</span><input type="number" class="form-input" id="goal-target" placeholder="20000"></div></div>
    <div class="form-group"><label class="form-label">Amount Already Saved (₹)</label><div class="amount-wrap"><span class="amount-prefix">₹</span><input type="number" class="form-input" id="goal-saved" placeholder="0"></div></div>
    <button class="submit-btn" onclick="saveGoal()">Save Goal →</button>
  </div>
</div>

<div class="success-toast" id="toast">✓ Done!</div>

<script>
  let expenses = JSON.parse(localStorage.getItem('budgify_expenses')||'[]');
  let goal     = JSON.parse(localStorage.getItem('budgify_goal')||'null');
  let period   = 'month';
  let pieInst=null, barInst=null;

  const CC = {Food:'#ff9800',Travel:'#2196f3',Shopping:'#e91e63',Entertainment:'#9c27b0',Health:'#4caf50',Education:'#00bcd4',Utilities:'#ff5722',Other:'#607d8b'};

  document.getElementById('inp-date').value = new Date().toISOString().split('T')[0];
  const sk = localStorage.getItem('budgify_gemini_key')||'';
  document.getElementById('api-key-input').value = sk;

  function saveApiKey(v){ localStorage.setItem('budgify_gemini_key',v.trim()); }
  function getApiKey(){ return document.getElementById('api-key-input').value.trim()||localStorage.getItem('budgify_gemini_key')||''; }

  function showPage(id,el){
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    document.getElementById('page-'+id).classList.add('active');
    if(el) el.classList.add('active');
    const T={dashboard:['Dashboard','Your financial overview at a glance'],add:['Add Expense','Record a new transaction'],reports:['Reports','Detailed expense analysis and history'],goals:['Goal Tracker','Monitor your savings progress']};
    document.getElementById('page-title').textContent=T[id][0];
    document.getElementById('page-sub').textContent=T[id][1];
    if(id==='dashboard') renderDashboard();
    if(id==='reports')   renderReports();
    if(id==='goals')     renderGoal();
  }

  function getFiltered(){
    const now=new Date();
    return expenses.filter(e=>{
      const d=new Date(e.date+'T00:00:00');
      if(period==='week'){const wa=new Date(now);wa.setDate(now.getDate()-7);return d>=wa;}
      if(period==='month') return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear();
      return true;
    });
  }

  function switchPeriod(p,el){
    period=p;
    document.querySelectorAll('.period-tab').forEach(t=>t.classList.remove('active'));
    el.classList.add('active');
    renderDashboard();
  }

  function renderDashboard(){
    const f=getFiltered();
    const total=f.reduce((s,e)=>s+e.amount,0);
    document.getElementById('stat-total').textContent='₹'+total.toLocaleString('en-IN');
    document.getElementById('stat-count').textContent=f.length;
    document.getElementById('stat-total-sub').textContent=f.length+' transaction'+(f.length!==1?'s':'');
    const ct={};
    f.forEach(e=>{ct[e.category]=(ct[e.category]||0)+e.amount;});
    const top=Object.entries(ct).sort((a,b)=>b[1]-a[1])[0];
    if(top){document.getElementById('stat-top-cat').textContent=top[0];document.getElementById('stat-top-val').textContent='₹'+top[1].toLocaleString('en-IN');}
    else{document.getElementById('stat-top-cat').textContent='–';document.getElementById('stat-top-val').textContent='No data';}
    const dates=f.map(e=>e.date).sort();
    const span=dates.length?Math.max(1,Math.ceil((new Date()-new Date(dates[0]+'T00:00:00'))/86400000)+1):1;
    document.getElementById('stat-avg').textContent='₹'+Math.round(total/span).toLocaleString('en-IN');
    renderPie(ct); renderBar(f);
    renderRecentTable(f.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6));
  }

  function renderPie(ct){
    const cats=Object.keys(ct),vals=Object.values(ct);
    const ctx=document.getElementById('pieChart').getContext('2d');
    if(pieInst) pieInst.destroy();
    if(!cats.length) return;
    pieInst=new Chart(ctx,{type:'doughnut',data:{labels:cats,datasets:[{data:vals,backgroundColor:cats.map(c=>CC[c]||'#888'),borderWidth:3,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'right',labels:{boxWidth:10,font:{size:11,family:'DM Sans'},padding:10}}}}});
  }

  function renderBar(f){
    const daily={};
    f.forEach(e=>{daily[e.date]=(daily[e.date]||0)+e.amount;});
    const sorted=Object.entries(daily).sort((a,b)=>a[0].localeCompare(b[0])).slice(-14);
    const labels=sorted.map(d=>{const dt=new Date(d[0]+'T00:00:00');return(dt.getMonth()+1)+'/'+dt.getDate();});
    const data=sorted.map(d=>d[1]);
    const ctx=document.getElementById('barChart').getContext('2d');
    if(barInst) barInst.destroy();
    if(!data.length) return;
    barInst=new Chart(ctx,{type:'bar',data:{labels,datasets:[{label:'Spent (₹)',data,backgroundColor:'#4DA8DA',borderRadius:6,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'rgba(0,0,0,0.05)'},ticks:{font:{size:10},callback:v=>'₹'+v}},x:{grid:{display:false},ticks:{font:{size:10},maxRotation:45,autoSkip:false}}}}});
  }

  function catBadge(c){return`<span class="cat-badge cat-${c.toLowerCase()}">${c}</span>`;}

  function renderRecentTable(list){
    const el=document.getElementById('recent-table-body');
    if(!list.length){el.innerHTML='<div class="empty-state"><div class="empty-state-icon">◈</div><p>No expenses yet. Add your first expense!</p></div>';return;}
    el.innerHTML=`<table><thead><tr><th>Date</th><th>Category</th><th>Notes</th><th style="text-align:right">Amount</th></tr></thead><tbody>${list.map(e=>`<tr><td style="color:var(--muted);font-size:12px;">${fmtDate(e.date)}</td><td>${catBadge(e.category)}</td><td style="color:var(--muted)">${e.notes||'–'}</td><td style="text-align:right;font-weight:500;color:var(--dark)">₹${e.amount.toLocaleString('en-IN')}</td></tr>`).join('')}</tbody></table>`;
  }

  function renderReports(){
    const ct={};expenses.forEach(e=>{ct[e.category]=(ct[e.category]||0)+e.amount;});
    const total=Object.values(ct).reduce((s,v)=>s+v,0);
    const sorted=Object.entries(ct).sort((a,b)=>b[1]-a[1]);
    document.getElementById('cat-breakdown').innerHTML=sorted.length
      ?sorted.map(([c,v])=>{const p=total?Math.round(v/total*100):0;return`<div class="cat-row"><div class="cat-row-label">${c}</div><div class="cat-bar-bg"><div class="cat-bar-fill" style="width:${p}%;background:${CC[c]||'#888'}"></div></div><div class="cat-row-val">₹${v.toLocaleString('en-IN')}</div></div>`;}).join('')
      :'<div class="empty-state" style="padding:20px 0;"><p>No data yet</p></div>';
    document.getElementById('total-count-label').textContent=expenses.length+' transactions';
    const el=document.getElementById('full-table-body');
    if(!expenses.length){el.innerHTML='<div class="empty-state"><div class="empty-state-icon">◈</div><p>No expenses recorded yet</p></div>';return;}
    const s2=[...expenses].sort((a,b)=>b.date.localeCompare(a.date));
    el.innerHTML=`<table><thead><tr><th>Date</th><th>Category</th><th>Notes</th><th style="text-align:right">Amount</th><th></th></tr></thead><tbody>${s2.map(e=>`<tr><td style="color:var(--muted);font-size:12px;">${fmtDate(e.date)}</td><td>${catBadge(e.category)}</td><td style="color:var(--muted)">${e.notes||'–'}</td><td style="text-align:right;font-weight:500;color:var(--dark)">₹${e.amount.toLocaleString('en-IN')}</td><td><button class="delete-btn" onclick="deleteExpense(${e.id})">✕</button></td></tr>`).join('')}</tbody></table>`;
  }

  function renderGoal(){
    if(!goal) return;
    const{target,saved,name}=goal;
    const pct=Math.min(100,Math.round(saved/target*100));
    document.getElementById('goal-title-display').textContent=name||'Savings Goal';
    document.getElementById('goal-sub').textContent=`Target: ₹${target.toLocaleString('en-IN')} · ₹${Math.max(0,target-saved).toLocaleString('en-IN')} remaining`;
    document.getElementById('progress-fill').style.width=pct+'%';
    document.getElementById('progress-saved').textContent='₹'+saved.toLocaleString('en-IN')+' saved';
    document.getElementById('progress-pct').textContent=pct+'%';
    document.getElementById('progress-target').textContent='Goal: ₹'+target.toLocaleString('en-IN');
    document.getElementById('m1-val').textContent='₹'+Math.round(target*0.25).toLocaleString('en-IN');
    document.getElementById('m2-val').textContent='₹'+Math.round(target*0.5).toLocaleString('en-IN');
    document.getElementById('m3-val').textContent='₹'+target.toLocaleString('en-IN');
    document.getElementById('m1').classList.toggle('done',pct>=25);
    document.getElementById('m2').classList.toggle('done',pct>=50);
    document.getElementById('m3').classList.toggle('done',pct>=100);
  }

  function fmtDate(d){const dt=new Date(d+'T00:00:00');return dt.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});}
  function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='block';setTimeout(()=>t.style.display='none',3000);}

  function addExpense(){
    const amount=parseFloat(document.getElementById('inp-amount').value);
    const category=document.getElementById('inp-category').value;
    const date=document.getElementById('inp-date').value;
    const notes=document.getElementById('inp-notes').value.trim();
    if(!amount||amount<=0||!date){alert('Please enter a valid amount and date.');return;}
    expenses.push({id:Date.now(),amount,category,date,notes});
    localStorage.setItem('budgify_expenses',JSON.stringify(expenses));
    document.getElementById('inp-amount').value='';
    document.getElementById('inp-notes').value='';
    showToast('✓ ₹'+amount.toLocaleString('en-IN')+' added to '+category);
    showPage('dashboard',document.querySelectorAll('.nav-item')[0]);
  }

  function deleteExpense(id){
    if(!confirm('Delete this expense?')) return;
    expenses=expenses.filter(e=>e.id!==id);
    localStorage.setItem('budgify_expenses',JSON.stringify(expenses));
    renderReports();showToast('Expense deleted');
  }

  function clearAll(){
    if(!confirm('Clear ALL expenses? This cannot be undone.')) return;
    expenses=[];localStorage.setItem('budgify_expenses',JSON.stringify(expenses));
    renderReports();renderDashboard();showToast('All expenses cleared');
  }

  function openGoalModal(){
    if(goal){document.getElementById('goal-name').value=goal.name||'';document.getElementById('goal-target').value=goal.target||'';document.getElementById('goal-saved').value=goal.saved||0;}
    document.getElementById('goal-modal').classList.add('open');
  }
  function closeGoalModal(){document.getElementById('goal-modal').classList.remove('open');}
  function saveGoal(){
    const name=document.getElementById('goal-name').value.trim()||'Savings Goal';
    const target=parseFloat(document.getElementById('goal-target').value);
    const saved=parseFloat(document.getElementById('goal-saved').value)||0;
    if(!target||target<=0){alert('Please enter a valid target amount.');return;}
    goal={name,target,saved};
    localStorage.setItem('budgify_goal',JSON.stringify(goal));
    closeGoalModal();renderGoal();showToast('✓ Goal saved!');
  }
  document.getElementById('goal-modal').addEventListener('click',function(e){if(e.target===this)closeGoalModal();});

  // ── GEMINI AI ──────────────────────────────────────────────────
  async function runAI(){
    const apiKey=getApiKey();
    if(!apiKey){alert('Please enter your free Gemini API key in the sidebar.\n\nSteps:\n1. Go to aistudio.google.com\n2. Sign in with Google\n3. Click "Get API Key"\n4. Copy and paste it here');return;}
    if(!expenses.length){alert('Please add some expenses first to get AI insights.');return;}

    const ct={};expenses.forEach(e=>{ct[e.category]=(ct[e.category]||0)+e.amount;});
    const total=Object.values(ct).reduce((s,v)=>s+v,0);
    const expSummary=Object.entries(ct).map(([k,v])=>`${k}: ₹${v}`).join('\n');
    const goalStr=goal?`\nSavings Goal: "${goal.name}" — target ₹${goal.target}, already saved ₹${goal.saved}.`:'';

    const prompt=`You are a personal finance advisor for an Indian user. Analyze these expenses and give smart, specific advice.\n\nExpense breakdown:\n${expSummary}\nTotal spent: ₹${total}${goalStr}\n\nRespond ONLY with a valid JSON object, no markdown, no backticks, no explanation:\n{"insights":[{"type":"warning","text":"..."},{"type":"good","text":"..."},{"type":"warning","text":"..."},{"type":"neutral","text":"..."}]}\n\nRules: Exactly 4 insights. Types: warning (overspending), good (positive), neutral (tip). Max 25 words each. Mention specific ₹ amounts. Be direct and actionable.`;

    const loading=`<div class="ai-loading"><div class="dot-pulse"><span></span><span></span><span></span></div>&nbsp; Gemini is analyzing your spending patterns...</div>`;
    document.getElementById('ai-insights-area').innerHTML=loading;
    document.getElementById('goal-ai-area').innerHTML=loading;

    try{
      const url=`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`;
      const res=await fetch(url,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          contents:[{parts:[{text:prompt}]}],
          generationConfig:{temperature:0.7,maxOutputTokens:512}
        })
      });
      if(!res.ok){const err=await res.json();throw new Error(err.error?.message||'API error '+res.status);}
      const data=await res.json();
      const rawText=data.candidates?.[0]?.content?.parts?.[0]?.text||'';
      const cleaned=rawText.replace(/```json|```/g,'').trim();
      const parsed=JSON.parse(cleaned);
      const insights=parsed.insights||[];

      const iHTML=`<div class="insights-list">${insights.map(i=>`<div class="insight-item ${i.type==='warning'?'warning':i.type==='good'?'good':''}">${i.text}</div>`).join('')}</div>`;
      document.getElementById('ai-insights-area').innerHTML=iHTML;

      if(goal){
        const rem=Math.max(0,goal.target-goal.saved);
        document.getElementById('goal-ai-area').innerHTML=`<div class="insights-list">
          <div class="insight-item good">You need ₹${rem.toLocaleString('en-IN')} more to reach your "${goal.name}" goal.</div>
          ${insights.filter(i=>i.type==='warning').map(i=>`<div class="insight-item warning">${i.text}</div>`).join('')}
          <div class="insight-item neutral">Redirect savings from top spending categories toward your goal each month.</div>
        </div>`;
      } else {
        document.getElementById('goal-ai-area').innerHTML=iHTML;
      }

      const savEl=document.getElementById('savings-area');
      if(savEl){
        const warns=insights.filter(i=>i.type==='warning');
        savEl.innerHTML=warns.length
          ?`<div class="insights-list" style="gap:8px;">${warns.map(i=>`<div class="insight-item warning" style="font-size:12px;">${i.text}</div>`).join('')}</div>`
          :`<div style="background:rgba(42,157,111,0.08);border-left:3px solid #2a9d6f;border-radius:var(--radius-sm);padding:12px 16px;font-size:13px;color:var(--text);">Your spending looks balanced! Keep it up.</div>`;
      }
      showToast('✦ AI insights generated by Gemini!');

    }catch(err){
      const errHTML=`<div class="insights-list"><div class="insight-item warning"><strong>Error:</strong> ${err.message}<br><br>Tips: Make sure your API key starts with "AIza" and is copied correctly from aistudio.google.com</div></div>`;
      document.getElementById('ai-insights-area').innerHTML=errHTML;
      document.getElementById('goal-ai-area').innerHTML=errHTML;
    }
  }

  renderDashboard();
</script>
</body>
</html>
